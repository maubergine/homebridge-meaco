{
  "name": "homebridge-meaco",
  "version": "1.3.1",
  "author": "maubergine",
  "description": "Homebridge plugin for Meaco air conditioners via Tuya Cloud OpenAPI",
  "license": "Apache-2.0",
  "repository": "maubergine/homebridge-meaco",
  "homepage": "https://github.com/maubergine/homebridge-meaco#readme",
  "bugs": {
    "url": "https://github.com/maubergine/homebridge-meaco/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22",
    "homebridge": "^2.0.0"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "supports-hap",
    "meaco",
    "tuya",
    "air-conditioner",
    "aircon"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.0",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.6.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "homebridge": "^2.0.0",
    "nock": "^15.0.1",
    "nodemon": "^3.1.0",
    "semantic-release": "^25.0.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "npm run build && nodemon",
    "lint": "eslint 'src/**/*.ts' --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepare": "git config core.hooksPath .githooks || true",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build",
    "pack:local": "scripts/pack-local.sh",
    "harness": "scripts/harness.sh",
    "commitlint": "commitlint",
    "semantic-release": "semantic-release"
  },
  "files": [
    "dist",
    "config.schema.json",
    "homebridge-ui"
  ],
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6",
    "ws": "^8.21.1"
  }
}
